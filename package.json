    "start": "npm exec linked dev",
    "build": "linked build",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@_linked/core": "^2.27.0",
    "@_linked/primitives": "^1.8.0",
    "@_linked/react": "^2.0.0",
    "@_linked/server-utils": "^1.14.0",
    "@_linked/xsd": "^1.0",
    "formidable": "^3.5.4",
    "prism-react-renderer": "^2.4.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@_linked/cli": "^1.45.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@types/formidable": "^3.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
